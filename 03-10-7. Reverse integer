"""
Given a signed 32-bit integer ⁠x⁠, return ⁠x⁠ with its digits reversed. If reversing ⁠x⁠ causes the value to go outside the signed 32-bit integer range [-2^{31}, 2^{31} - 1], then return ⁠0⁠.  
Assume the environment does not allow you to store 64-bit integers (signed or unsigned).  
Example 1:
 Input: ⁠x = 123⁠  
 Output: ⁠321⁠  
Example 2:
 Input: ⁠x = -123⁠  
 Output: ⁠-321⁠  
Example 3:
 Input: ⁠x = 120⁠  
 Output: ⁠21⁠  

"""

Solution:
class Solution(object):
    def reverse(self, x):
        """
        :type x: int
        :rtype: int
        """
        # Define 32-bit signed integer limits
        INT_MAX = 2**31 - 1
        INT_MIN = -2**31

        res = 0
        sign = -1 if x < 0 else 1
        x = abs(x)

        while x != 0:
            pop = x % 10
            x //= 10

            # Check overflow before multiplying res by 10 and adding pop
            if sign == 1:
                if res > INT_MAX // 10 or (res == INT_MAX // 10 and pop > INT_MAX % 10):
                    return 0
            else:
                if res > abs(INT_MIN) // 10 or (res == abs(INT_MIN) // 10 and pop > abs(INT_MIN) % 10):
                    return 0

            res = res * 10 + pop

        return res * sign
